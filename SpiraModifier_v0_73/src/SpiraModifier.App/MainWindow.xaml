<Window x:Class="SpiraModifier.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Spira Modifier v0.73" Height="800" Width="1280"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="10,5"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Padding" Value="0,3"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="3,2"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="2"/>
        </Style>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="S" Modifiers="Ctrl" Command="ApplicationCommands.Save"/>
        <KeyBinding Key="S" Modifiers="Ctrl+Shift" Command="ApplicationCommands.SaveAs"/>
    </Window.InputBindings>

    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Save" Executed="OnSave_Click"/>
        <CommandBinding Command="ApplicationCommands.SaveAs" Executed="OnSaveAs_Click"/>
    </Window.CommandBindings>

    <DockPanel>
        <!-- Barre supérieure : menu à gauche, sélecteur de langue à droite -->
        <Grid DockPanel.Dock="Top" Background="#F0F0F0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Menu Grid.Column="0" Background="Transparent">
                <MenuItem Header="_Fichier">
                    <MenuItem Header="_Ouvrir un dossier extrait..." Click="OnOpenFolder_Click"/>
                    <Separator/>
                    <MenuItem Header="_Sauvegarder" InputGestureText="Ctrl+S"
                              Click="OnSave_Click" x:Name="MenuSave"
                              ToolTip="Écrit les modifications dans le dossier de sortie configuré. La première fois, demande où sauvegarder."/>
                    <MenuItem Header="Sauvegarder _sous..." InputGestureText="Ctrl+Maj+S"
                              Click="OnSaveAs_Click" x:Name="MenuSaveAs"
                              ToolTip="Choisit un nouveau dossier de sortie."/>
                    <MenuItem Header="Effacer le dossier de sortie configuré" Click="OnClearOutputFolder_Click"/>
                    <Separator/>
                    <MenuItem x:Name="MenuRoundTripSave" Header="🔁 Test : sauvegarder TOUS les fichiers (round-trip vanilla)"
                              Click="OnRoundTripSave_Click"
                              ToolTip="Force la réécriture de tous les fichiers monsterN.bin chargés, même sans modifications. Permet de vérifier que le décodage→réencodage produit des fichiers identiques au vanilla."/>
                    <Separator/>
                    <MenuItem Header="Configurer le dossier _vanilla de référence..." Click="OnConfigureVanillaFolder_Click"
                              ToolTip="Pour les hardmods incomplets : pointer vers une copie vanilla qui sera utilisée comme fallback (charsets, fichiers monstres non modifiés, etc.)"/>
                    <MenuItem Header="Configurer le dossier _ffx_encoding/ externe..." Click="OnConfigureEncodingFolder_Click"
                              ToolTip="Si tu n'as qu'un dossier ffx_encoding/ vanilla quelque part (sans tout le reste)"/>
                    <MenuItem Header="Effacer la configuration de référence" Click="OnClearReferenceConfig_Click"/>
                    <Separator/>
                    <MenuItem Header="_Quitter" Click="OnExit_Click"/>
                </MenuItem>
            </Menu>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,12,0" VerticalAlignment="Center">
                <TextBlock Text="Langue du logiciel :" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="SemiBold"/>
                <ComboBox x:Name="InterfaceLanguageSelector"
                          Width="105"
                          Margin="0,0,16,0"
                          SelectionChanged="OnInterfaceLanguageSelector_Changed"
                          ToolTip="Choisir la langue de l'interface">
                    <ComboBoxItem Content="Français" Tag="fr"/>
                    <ComboBoxItem Content="English" Tag="en"/>
                </ComboBox>
                <TextBlock Text="Langue des fichiers :" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="SemiBold"/>
                <ComboBox x:Name="LanguageSelector"
                          Width="140"
                          SelectionChanged="OnLanguageSelector_Changed"
                          ToolTip="Choisir la langue pour les noms et textes (s'applique à tous les onglets)"/>
            </StackPanel>
        </Grid>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem><TextBlock x:Name="StatusText" Text="Prêt. Ouvre un dossier extrait via Fichier &gt; Ouvrir."/></StatusBarItem>
        </StatusBar>

        <TabControl x:Name="MainTabs">

            <!-- ============ ONGLET MONSTRES ============ -->
            <TabItem x:Name="TabMonsters" Header="Monstres" IsEnabled="False">
                <DockPanel>
                    <!-- Sidebar gauche -->
                    <Border DockPanel.Dock="Left" BorderBrush="#CCCCCC" BorderThickness="0,0,1,0" Width="260">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Margin="6">
                                <TextBox x:Name="MonsterFilterBox" Padding="4,3"
                                         ToolTip="Filtrer (par ID de fichier ou nom décodé)"
                                         TextChanged="OnMonsterFilter_Changed"/>
                                <TextBlock Text="🔍 Filtrer..." Foreground="#888888"
                                           Margin="8,0,0,0" VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           x:Name="FilterPlaceholder"/>
                            </Grid>
                            <TextBlock DockPanel.Dock="Bottom" x:Name="MonsterCountText"
                                       Margin="6,4" Foreground="#666666" FontSize="11"/>
                            <ListBox x:Name="MonsterListBox"
                                     BorderThickness="0"
                                     SelectionChanged="OnMonsterSelection_Changed"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                        </DockPanel>
                    </Border>

                    <!-- Panneau de droite -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid Margin="20">
                            <TextBlock x:Name="NoMonsterSelectedMessage"
                                       Text="← Sélectionne un monstre dans la liste pour voir ses propriétés."
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="Gray" FontStyle="Italic"/>

                            <StackPanel x:Name="MonsterDetailsPanel" Visibility="Collapsed">
                                <TextBlock x:Name="MonsterHeaderText" FontSize="20" FontWeight="Bold"/>
                                <TextBlock x:Name="MonsterFileInfoText" Foreground="#666666" Margin="0,0,0,15"/>

                                <!-- Textes localisés (Name / Sensor / Scan dans la langue sélectionnée) -->
                                <GroupBox x:Name="LocalizedTextsGroup" Header="Textes du Bestiaire (langue sélectionnée)">
                                    <StackPanel>
                                        <!-- Légende des tokens -->
                                        <Border Margin="0,0,0,8" Padding="6" Background="#FFF9E6"
                                                BorderBrush="#E0D080" BorderThickness="1" CornerRadius="3">
                                            <StackPanel>
                                                <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="#553300">
                                                    <Run FontWeight="Bold">Codes de contrôle FFX :</Run>
                                                    écris-les directement dans le texte.
                                                    <Run FontFamily="Consolas">{\n}</Run> = saut de ligne ·
                                                    <Run FontFamily="Consolas">{CLR:RED}</Run> = couleur (WHITE, YELLOW, GREY, BLUE, RED, PINK, OL_PURPLE, OL_CYAN) ·
                                                    <Run FontFamily="Consolas">{PAUSE}</Run> = pause ·
                                                    <Run FontFamily="Consolas">{VAR:NN}</Run>,
                                                    <Run FontFamily="Consolas">{PC:NN}</Run> = variables.
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>

                                        <!-- Barre d'insertion rapide -->
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <TextBlock Text="Insérer :" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="11"/>
                                            <Button Content="{}{\n}" Click="OnInsertToken_Click" Tag="{}{\n}"
                                                    Padding="6,2" Margin="0,0,4,0" FontFamily="Consolas" FontSize="11"
                                                    ToolTip="Saut de ligne (raccourci : Entrée dans une zone multi-ligne)"/>
                                            <Button Content="{}{PAUSE}" Click="OnInsertToken_Click" Tag="{}{PAUSE}"
                                                    Padding="6,2" Margin="0,0,4,0" FontFamily="Consolas" FontSize="11"
                                                    ToolTip="Pause"/>
                                            <TextBlock Text="Couleur :" VerticalAlignment="Center" Margin="8,0,4,0" FontSize="11"/>
                                            <ComboBox x:Name="InsertColorBox" Width="105" Margin="0,0,4,0" FontSize="11"
                                                      SelectionChanged="OnInsertColor_SelectionChanged"
                                                      ToolTip="Choisis une couleur pour l'insérer à la position du curseur">
                                                <ComboBoxItem Content="-- couleur --" IsSelected="True" Tag=""/>
                                                <ComboBoxItem Content="WHITE" Tag="WHITE"/>
                                                <ComboBoxItem Content="YELLOW" Tag="YELLOW"/>
                                                <ComboBoxItem Content="GREY" Tag="GREY"/>
                                                <ComboBoxItem Content="BLUE" Tag="BLUE"/>
                                                <ComboBoxItem Content="RED" Tag="RED"/>
                                                <ComboBoxItem Content="PINK" Tag="PINK"/>
                                                <ComboBoxItem Content="OL_PURPLE" Tag="OL_PURPLE"/>
                                                <ComboBoxItem Content="OL_CYAN" Tag="OL_CYAN"/>
                                            </ComboBox>
                                        </StackPanel>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Label   Grid.Row="0" Grid.Column="0" Content="Nom :" VerticalAlignment="Top" Margin="0,4,0,0"/>
                                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="LocalizedNameBox" TextChanged="OnMonsterText_Changed"/>

                                            <Label   Grid.Row="1" Grid.Column="0" Content="Sensor :" VerticalAlignment="Top" Margin="0,4,0,0"/>
                                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="LocalizedSensorBox" TextChanged="OnMonsterText_Changed"
                                                     PreviewKeyDown="OnMonsterTextBox_KeyDown"
                                                     TextWrapping="Wrap" AcceptsReturn="True" MinHeight="40" MaxHeight="100"
                                                     VerticalScrollBarVisibility="Auto"/>

                                            <Label   Grid.Row="2" Grid.Column="0" Content="Sensor (court) :" VerticalAlignment="Top" Margin="0,4,0,0"/>
                                            <TextBox Grid.Row="2" Grid.Column="1" x:Name="LocalizedSimplifiedSensorBox" TextChanged="OnMonsterText_Changed"
                                                     PreviewKeyDown="OnMonsterTextBox_KeyDown"
                                                     TextWrapping="Wrap" AcceptsReturn="True" MinHeight="30" MaxHeight="80"
                                                     VerticalScrollBarVisibility="Auto"/>

                                            <Label   Grid.Row="3" Grid.Column="0" Content="Scan :" VerticalAlignment="Top" Margin="0,4,0,0"/>
                                            <TextBox Grid.Row="3" Grid.Column="1" x:Name="LocalizedScanBox" TextChanged="OnMonsterText_Changed"
                                                     PreviewKeyDown="OnMonsterTextBox_KeyDown"
                                                     TextWrapping="Wrap" AcceptsReturn="True" MinHeight="60" MaxHeight="160"
                                                     VerticalScrollBarVisibility="Auto"/>

                                            <Label   Grid.Row="4" Grid.Column="0" Content="Scan (court) :" VerticalAlignment="Top" Margin="0,4,0,0"/>
                                            <TextBox Grid.Row="4" Grid.Column="1" x:Name="LocalizedSimplifiedScanBox" TextChanged="OnMonsterText_Changed"
                                                     PreviewKeyDown="OnMonsterTextBox_KeyDown"
                                                     TextWrapping="Wrap" AcceptsReturn="True" MinHeight="40" MaxHeight="120"
                                                     VerticalScrollBarVisibility="Auto"/>
                                        </Grid>

                                        <Border Margin="0,8,0,0" Padding="6" Background="#F5F5F5" CornerRadius="3">
                                            <StackPanel Orientation="Horizontal">
                                                <Button x:Name="ApplyMonsterTextsButton" Content="✓ Appliquer les modifications"
                                                        Click="OnApplyMonsterTexts_Click" IsEnabled="False"
                                                        Padding="10,4" Margin="0,0,8,0"
                                                        ToolTip="Réencode les textes et les marque pour la prochaine sauvegarde."/>
                                                <Button x:Name="RevertMonsterTextsButton" Content="↶ Annuler"
                                                        Click="OnRevertMonsterTexts_Click" IsEnabled="False"
                                                        Padding="10,4" Margin="0,0,8,0"
                                                        ToolTip="Restaure les textes tels qu'ils sont actuellement enregistrés."/>
                                                <TextBlock x:Name="MonsterEditStatusText" VerticalAlignment="Center"
                                                           Foreground="#666666" FontStyle="Italic"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </GroupBox>

                                <!-- Récompenses et drops (chunk Loot) -->
                                <GroupBox Header="Récompenses et drops">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120"/><ColumnDefinition Width="220"/><ColumnDefinition Width="20"/>
                                                <ColumnDefinition Width="120"/><ColumnDefinition Width="100"/><ColumnDefinition Width="20"/>
                                                <ColumnDefinition Width="120"/><ColumnDefinition Width="100"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                            <Label   Grid.Row="0" Grid.Column="0" Content="Gils :"/>
                                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="LootGilBox" TextChanged="OnMonsterStat_Changed"/>
                                            <Label   Grid.Row="0" Grid.Column="3" Content="EXP normal :"/>
                                            <TextBox Grid.Row="0" Grid.Column="4" x:Name="LootApNormalBox" TextChanged="OnMonsterStat_Changed"/>
                                            <Label   Grid.Row="0" Grid.Column="6" Content="EXP overkill :"/>
                                            <TextBox Grid.Row="0" Grid.Column="7" x:Name="LootApOverkillBox" TextChanged="OnMonsterStat_Changed"/>

                                            <Label   Grid.Row="1" Grid.Column="0" Content="Émulattaque :"/>
                                            <ComboBox Grid.Row="1" Grid.Column="1" x:Name="LootRonsoRageCombo"
                                                      DisplayMemberPath="DisplayName" SelectedValuePath="Id"
                                                      TextSearch.TextPath="SearchText" IsTextSearchEnabled="True"
                                                      SelectionChanged="OnMonsterLootCombo_Changed"/>
                                            <Label   Grid.Row="1" Grid.Column="3" Content="Drop principal :"/>
                                            <TextBox Grid.Row="1" Grid.Column="4" x:Name="LootDropChancePrimaryBox" TextChanged="OnMonsterStat_Changed"/>
                                            <Label   Grid.Row="1" Grid.Column="6" Content="Drop secondaire :"/>
                                            <TextBox Grid.Row="1" Grid.Column="7" x:Name="LootDropChanceSecondaryBox" TextChanged="OnMonsterStat_Changed"/>

                                            <Label   Grid.Row="2" Grid.Column="0" Content="Drop équipement :"/>
                                            <TextBox Grid.Row="2" Grid.Column="1" x:Name="LootDropChanceGearBox" TextChanged="OnMonsterStat_Changed"/>
                                            <Label   Grid.Row="2" Grid.Column="3" Content="Prix arène :"/>
                                            <TextBox Grid.Row="2" Grid.Column="4" x:Name="LootArenaPriceBox" TextChanged="OnMonsterStat_Changed"/>
                                        </Grid>

                                        <TextBlock Text="Drop principal" FontWeight="Bold" Margin="0,10,0,2"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="130"/><ColumnDefinition Width="250"/><ColumnDefinition Width="60"/>
                                                <ColumnDefinition Width="20"/>
                                                <ColumnDefinition Width="130"/><ColumnDefinition Width="250"/><ColumnDefinition Width="60"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                            <Label   Grid.Row="0" Grid.Column="0" Content="Normal commun :"/>
                                            <ComboBox Grid.Row="0" Grid.Column="1" x:Name="LootPrimaryNormalCommonItemCombo"
                                                      DisplayMemberPath="DisplayName" SelectedValuePath="Id"
                                                      TextSearch.TextPath="SearchText" IsTextSearchEnabled="True"
                                                      SelectionChanged="OnMonsterLootCombo_Changed"/>
                                            <TextBox Grid.Row="0" Grid.Column="2" x:Name="LootPrimaryNormalCommonQtyBox" TextChanged="OnMonsterStat_Changed" ToolTip="Quantité"/>
                                            <Label   Grid.Row="0" Grid.Column="4" Content="Normal rare :"/>
                                            <ComboBox Grid.Row="0" Grid.Column="5" x:Name="LootPrimaryNormalRareItemCombo"
                                                      DisplayMemberPath="DisplayName" SelectedValuePath="Id"
                                                      TextSearch.TextPath="SearchText" IsTextSearchEnabled="True"
                                                      SelectionChanged="OnMonsterLootCombo_Changed"/>
                                            <TextBox Grid.Row="0" Grid.Column="6" x:Name="LootPrimaryNormalRareQtyBox" TextChanged="OnMonsterStat_Changed" ToolTip="Quantité"/>
                                            <Label   Grid.Row="1" Grid.Column="0" Content="Overkill commun :"/>
                                            <ComboBox Grid.Row="1" Grid.Column="1" x:Name="LootPrimaryOkCommonItemCombo"
                                                      DisplayMemberPath="DisplayName" SelectedValuePath="Id"
                                                      TextSearch.TextPath="SearchText" IsTextSearchEnabled="True"
                                                      SelectionChanged="OnMonsterLootCombo_Changed"/>
                                            <TextBox Grid.Row="1" Grid.Column="2" x:Name="LootPrimaryOkCommonQtyBox" TextChanged="OnMonsterStat_Changed" ToolTip="Quantité"/>
                                            <Label   Grid.Row="1" Grid.Column="4" Content="Overkill rare :"/>
                                            <ComboBox Grid.Row="1" Grid.Column="5" x:Name="LootPrimaryOkRareItemCombo"
                                                      DisplayMemberPath="DisplayName" SelectedValuePath="Id"
                                                      TextSearch.TextPath="SearchText" IsTextSearchEnabled="True"
                                                      SelectionChanged="OnMonsterLootCombo_Changed"/>
                                            <TextBox Grid.Row="1" Grid.Column="6" x:Name="LootPrimaryOkRareQtyBox" TextChanged="OnMonsterStat_Changed" ToolTip="Quantité"/>
                                        </Grid>

                                        <TextBlock Text="Drop secondaire" FontWeight="Bold" Margin="0,10,0,2"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="130"/><ColumnDefinition Width="250"/><ColumnDefinition Width="60"/>
                                                <ColumnDefinition Width="20"/>
                                                <ColumnDefinition Width="130"/><ColumnDefinition Width="250"/><ColumnDefinition Width="60"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                            <Label   Grid.Row="0" Grid.Column="0" Content="Normal commun :"/>
                                            <ComboBox Grid.Row="0" Grid.Column="1" x:Name="LootSecondaryNormalCommonItemCombo"
                                                      DisplayMemberPath="DisplayName" SelectedValuePath="Id"
                                                      TextSearch.TextPath="SearchText" IsTextSearchEnabled="True"
                                                      SelectionChanged="OnMonsterLootCombo_Changed"/>
                                            <TextBox Grid.Row="0" Grid.Column="2" x:Name="LootSecondaryNormalCommonQtyBox" TextChanged="OnMonsterStat_Changed" ToolTip="Quantité"/>
                                            <Label   Grid.Row="0" Grid.Column="4" Content="Normal rare :"/>
                                            <ComboBox Grid.Row="0" Grid.Column="5" x:Name="LootSecondaryNormalRareItemCombo"
                                                      DisplayMemberPath="DisplayName" SelectedValuePath="Id"
                                                      TextSearch.TextPath="SearchText" IsTextSearchEnabled="True"
                                                      SelectionChanged="OnMonsterLootCombo_Changed"/>
                                            <TextBox Grid.Row="0" Grid.Column="6" x:Name="LootSecondaryNormalRareQtyBox" TextChanged="OnMonsterStat_Changed" ToolTip="Quantité"/>
                                            <Label   Grid.Row="1" Grid.Column="0" Content="Overkill commun :"/>
                                            <ComboBox Grid.Row="1" Grid.Column="1" x:Name="LootSecondaryOkCommonItemCombo"
                                                      DisplayMemberPath="DisplayName" SelectedValuePath="Id"
                                                      TextSearch.TextPath="SearchText" IsTextSearchEnabled="True"
                                                      SelectionChanged="OnMonsterLootCombo_Changed"/>
                                            <TextBox Grid.Row="1" Grid.Column="2" x:Name="LootSecondaryOkCommonQtyBox" TextChanged="OnMonsterStat_Changed" ToolTip="Quantité"/>
                                            <Label   Grid.Row="1" Grid.Column="4" Content="Overkill rare :"/>
                                            <ComboBox Grid.Row="1" Grid.Column="5" x:Name="LootSecondaryOkRareItemCombo"
                                                      DisplayMemberPath="DisplayName" SelectedValuePath="Id"
                                                      TextSearch.TextPath="SearchText" IsTextSearchEnabled="True"
                                                      SelectionChanged="OnMonsterLootCombo_Changed"/>
                                            <TextBox Grid.Row="1" Grid.Column="6" x:Name="LootSecondaryOkRareQtyBox" TextChanged="OnMonsterStat_Changed" ToolTip="Quantité"/>
                                        </Grid>

                                        <TextBlock Text="Vol / pots-de-vin / équipement" FontWeight="Bold" Margin="0,10,0,2"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120"/><ColumnDefinition Width="250"/><ColumnDefinition Width="60"/><ColumnDefinition Width="20"/>
                                                <ColumnDefinition Width="130"/><ColumnDefinition Width="250"/><ColumnDefinition Width="60"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                            <Label   Grid.Row="0" Grid.Column="0" Content="Vol commun :"/>
                                            <ComboBox Grid.Row="0" Grid.Column="1" x:Name="LootStealCommonItemCombo"
                                                      DisplayMemberPath="DisplayName" SelectedValuePath="Id"
                                                      TextSearch.TextPath="SearchText" IsTextSearchEnabled="True"
                                                      SelectionChanged="OnMonsterLootCombo_Changed"/>
                                            <TextBox Grid.Row="0" Grid.Column="2" x:Name="LootStealCommonQtyBox" TextChanged="OnMonsterStat_Changed" ToolTip="Quantité"/>
                                            <Label   Grid.Row="0" Grid.Column="4" Content="Vol rare :"/>
                                            <ComboBox Grid.Row="0" Grid.Column="5" x:Name="LootStealRareItemCombo"
                                                      DisplayMemberPath="DisplayName" SelectedValuePath="Id"
                                                      TextSearch.TextPath="SearchText" IsTextSearchEnabled="True"
                                                      SelectionChanged="OnMonsterLootCombo_Changed"/>
                                            <TextBox Grid.Row="0" Grid.Column="6" x:Name="LootStealRareQtyBox" TextChanged="OnMonsterStat_Changed" ToolTip="Quantité"/>

                                            <Label   Grid.Row="1" Grid.Column="0" Content="Chance vol :"/>
                                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="LootStealChanceBox"
                                                     TextChanged="OnMonsterStat_Changed"
                                                     ToolTip="Chance globale de vol, sur 255. 0 = aucun vol possible, même si les objets de vol sont renseignés."/>

                                            <Label   Grid.Row="2" Grid.Column="0" Content="Pots-de-vin :"/>
                                            <ComboBox Grid.Row="2" Grid.Column="1" x:Name="LootBribeItemCombo"
                                                      DisplayMemberPath="DisplayName" SelectedValuePath="Id"
                                                      TextSearch.TextPath="SearchText" IsTextSearchEnabled="True"
                                                      SelectionChanged="OnMonsterLootCombo_Changed"/>
                                            <TextBox Grid.Row="2" Grid.Column="2" x:Name="LootBribeQtyBox" TextChanged="OnMonsterStat_Changed" ToolTip="Quantité"/>
                                            <Label   Grid.Row="2" Grid.Column="4" Content="Gils volés :"/>
                                            <TextBox Grid.Row="2" Grid.Column="5" x:Name="LootGilStealBox" TextChanged="OnMonsterStat_Changed" ToolTip="Byte brut, valeur max en jeu = byte * 100"/>

                                            <Label   Grid.Row="3" Grid.Column="0" Content="Slots équ. :"/>
                                            <ComboBox Grid.Row="3" Grid.Column="1" x:Name="LootGearSlotsCombo"
                                                      DisplayMemberPath="DisplayName" SelectedValuePath="Id"
                                                      SelectionChanged="OnMonsterLootCombo_Changed"/>
                                            <Label   Grid.Row="3" Grid.Column="4" Content="Aptitudes équ. :"/>
                                            <ComboBox Grid.Row="3" Grid.Column="5" x:Name="LootGearAbilityCountCombo"
                                                      DisplayMemberPath="DisplayName" SelectedValuePath="Id"
                                                      SelectionChanged="OnMonsterLootCombo_Changed"/>

                                            <Label   Grid.Row="4" Grid.Column="0" Content="Aptitude arme :"/>
                                            <ComboBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" x:Name="LootWeaponForcedAbilityCombo"
                                                      DisplayMemberPath="DisplayName" SelectedValuePath="Id"
                                                      TextSearch.TextPath="SearchText" IsTextSearchEnabled="True"
                                                      SelectionChanged="OnMonsterLootCombo_Changed"/>
                                            <Label   Grid.Row="4" Grid.Column="4" Content="Aptitude protection :"/>
                                            <ComboBox Grid.Row="4" Grid.Column="5" Grid.ColumnSpan="2" x:Name="LootArmorForcedAbilityCombo"
                                                      DisplayMemberPath="DisplayName" SelectedValuePath="Id"
                                                      TextSearch.TextPath="SearchText" IsTextSearchEnabled="True"
                                                      SelectionChanged="OnMonsterLootCombo_Changed"/>
                                        </Grid>

                                        <Border Margin="0,10,0,0" Padding="6" Background="#F5F5F5" CornerRadius="3">
                                            <TextBlock x:Name="LootResolvedSummaryText"
                                                       TextWrapping="Wrap"
                                                       FontFamily="Consolas"
                                                       FontSize="11"
                                                       Foreground="#555555"/>
                                        </Border>
                                    </StackPanel>
                                </GroupBox>

                                <!-- Stats principales -->
                                <GroupBox Header="Stats principales">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/><ColumnDefinition Width="100"/><ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="100"/><ColumnDefinition Width="100"/><ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="100"/><ColumnDefinition Width="100"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <Label   Grid.Row="0" Grid.Column="0" Content="HP max :"/>
                                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="StatHpBox" TextChanged="OnMonsterStat_Changed"/>
                                        <Label   Grid.Row="0" Grid.Column="3" Content="MP max :"/>
                                        <TextBox Grid.Row="0" Grid.Column="4" x:Name="StatMpBox" TextChanged="OnMonsterStat_Changed"/>
                                        <Label   Grid.Row="0" Grid.Column="6" Content="Overkill :"/>
                                        <TextBox Grid.Row="0" Grid.Column="7" x:Name="StatOverkillBox" TextChanged="OnMonsterStat_Changed"/>

                                        <Label   Grid.Row="1" Grid.Column="0" Content="Force :"/>
                                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="StatStrBox" TextChanged="OnMonsterStat_Changed"/>
                                        <Label   Grid.Row="1" Grid.Column="3" Content="Défense :"/>
                                        <TextBox Grid.Row="1" Grid.Column="4" x:Name="StatDefBox" TextChanged="OnMonsterStat_Changed"/>
                                        <Label   Grid.Row="1" Grid.Column="6" Content="Magie :"/>
                                        <TextBox Grid.Row="1" Grid.Column="7" x:Name="StatMagBox" TextChanged="OnMonsterStat_Changed"/>

                                        <Label   Grid.Row="2" Grid.Column="0" Content="Déf. mag. :"/>
                                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="StatMdfBox" TextChanged="OnMonsterStat_Changed"/>
                                        <Label   Grid.Row="2" Grid.Column="3" Content="Agilité :"/>
                                        <TextBox Grid.Row="2" Grid.Column="4" x:Name="StatAgiBox" TextChanged="OnMonsterStat_Changed"/>
                                        <Label   Grid.Row="2" Grid.Column="6" Content="Chance :"/>
                                        <TextBox Grid.Row="2" Grid.Column="7" x:Name="StatLckBox" TextChanged="OnMonsterStat_Changed"/>

                                        <Label   Grid.Row="3" Grid.Column="0" Content="Esquive :"/>
                                        <TextBox Grid.Row="3" Grid.Column="1" x:Name="StatEvaBox" TextChanged="OnMonsterStat_Changed"/>
                                        <Label   Grid.Row="3" Grid.Column="3" Content="Précision :"/>
                                        <TextBox Grid.Row="3" Grid.Column="4" x:Name="StatAccBox" TextChanged="OnMonsterStat_Changed"/>
                                        <Label   Grid.Row="3" Grid.Column="6" Content="Poison % :"/>
                                        <TextBox Grid.Row="3" Grid.Column="7" x:Name="StatPoisonBox" TextChanged="OnMonsterStat_Changed"/>
                                    </Grid>
                                </GroupBox>

                                <!-- Affinités élémentaires (grille détaillée comme l'éditeur référence) -->
                                <GroupBox Header="Affinités élémentaires">
                                    <Grid x:Name="ElementsGrid">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="80"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <!-- Header row -->
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="" />
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="Absorbe" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Immun" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                        <TextBlock Grid.Row="0" Grid.Column="3" Text="Résiste" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                        <TextBlock Grid.Row="0" Grid.Column="4" Text="Faible" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                        <!-- Per-element rows are populated in code-behind -->
                                    </Grid>
                                </GroupBox>

                                <!-- Résistances aux statuts (25 valeurs) -->
                                <GroupBox Header="Résistances aux statuts (0 = pas de résistance, 255 = immunité)">
                                    <Grid x:Name="StatusResistGrid">
                                        <!-- Populated in code-behind -->
                                    </Grid>
                                </GroupBox>

                                <!-- Auto-statuts : Permanent / Temporal / Extra -->
                                <GroupBox Header="Auto-statuts (statuts présents dès le début du combat)">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Permanents" FontWeight="Bold" Margin="0,0,0,4"/>
                                            <WrapPanel x:Name="AutoStatusPermanentPanel"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Temporels" FontWeight="Bold" Margin="0,0,0,4"/>
                                            <WrapPanel x:Name="AutoStatusTemporalPanel"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Extras" FontWeight="Bold" Margin="0,0,0,4"/>
                                            <WrapPanel x:Name="AutoStatusExtraPanel"/>
                                        </StackPanel>
                                    </Grid>
                                </GroupBox>

                                <!-- Immunités aux statuts extra -->
                                <GroupBox Header="Immunités extra (Scan, Distill, Shield, Auto-Vie, Doom...)">
                                    <WrapPanel x:Name="ExtraStatusImmunityPanel"/>
                                </GroupBox>

                                <!-- Immunités spéciales -->
                                <GroupBox Header="Immunités spéciales (Enemy Exclusives)">
                                    <WrapPanel x:Name="ImmunitiesPanel"/>
                                </GroupBox>

                                <!-- Liste des commandes -->
                                <GroupBox Header="Liste des commandes (16 slots)">
                                    <ListView x:Name="CommandsListView" Height="280">
                                        <ListView.View>
                                            <GridView>
                                                <GridViewColumn Header="Slot" Width="50" DisplayMemberBinding="{Binding Slot}"/>
                                                <GridViewColumn Header="ID hex" Width="80" DisplayMemberBinding="{Binding HexId}"/>
                                                <GridViewColumn Header="Source" Width="90" DisplayMemberBinding="{Binding SourceLabel}"/>
                                                <GridViewColumn Header="Nom" Width="220" DisplayMemberBinding="{Binding Name}"/>
                                                <GridViewColumn Header="État" Width="100" DisplayMemberBinding="{Binding Status}"/>
                                            </GridView>
                                        </ListView.View>
                                    </ListView>
                                </GroupBox>

                                <!-- Métadonnées combat -->
                                <GroupBox Header="Métadonnées combat">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/><ColumnDefinition Width="100"/><ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="120"/><ColumnDefinition Width="100"/><ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="120"/><ColumnDefinition Width="100"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                        <Label   Grid.Row="0" Grid.Column="0" Content="Action forcée :"/>
                                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="MetaForcedActionBox" TextChanged="OnMonsterStat_Changed"/>
                                        <Label   Grid.Row="0" Grid.Column="3" Content="ID monstre :"/>
                                        <TextBox Grid.Row="0" Grid.Column="4" x:Name="MetaMonsterIdxBox" TextChanged="OnMonsterStat_Changed"/>
                                        <Label   Grid.Row="0" Grid.Column="6" Content="ID modèle :"/>
                                        <TextBox Grid.Row="0" Grid.Column="7" x:Name="MetaModelIdxBox" TextChanged="OnMonsterStat_Changed"/>
                                        <Label   Grid.Row="1" Grid.Column="0" Content="Compteur Doom :"/>
                                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="MetaDoomBox" TextChanged="OnMonsterStat_Changed"/>
                                        <Label   Grid.Row="1" Grid.Column="3" Content="ID arène (capt.) :"/>
                                        <TextBox Grid.Row="1" Grid.Column="4" x:Name="MetaArenaBox" TextChanged="OnMonsterStat_Changed"/>
                                        <Label   Grid.Row="1" Grid.Column="6" Content="Banque audio :"/>
                                        <TextBox Grid.Row="1" Grid.Column="7" x:Name="MetaSoundBankBox" TextChanged="OnMonsterStat_Changed"/>
                                        <Label   Grid.Row="2" Grid.Column="0" Content="Icône CTB :"/>
                                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="MetaCtbIconBox" TextChanged="OnMonsterStat_Changed"/>
                                    </Grid>
                                </GroupBox>

                                <Border Margin="0,8,0,0" Padding="6" Background="#F5F5F5" CornerRadius="3">
                                    <WrapPanel>
                                        <Button x:Name="ApplyMonsterStatsButton" Content="✓ Appliquer stats/drops"
                                                Click="OnApplyMonsterStats_Click" IsEnabled="False"
                                                Padding="10,4" Margin="0,0,8,0"
                                                ToolTip="Applique les récompenses, drops, stats, affinités, résistances, auto-statuts et métadonnées au fichier monstre."/>
                                        <Button x:Name="CopyMonsterMechanicsButton" Content="⧉ Copier mécaniques"
                                                Click="OnCopyMonsterMechanics_Click" IsEnabled="False"
                                                Padding="10,4" Margin="0,0,8,0"
                                                ToolTip="Copie les stats, drops, résistances et métadonnées de combat du monstre courant, sans copier les textes ni l'ID localisé."/>
                                        <Button x:Name="PasteMonsterMechanicsButton" Content="⤓ Coller mécaniques"
                                                Click="OnPasteMonsterMechanics_Click" IsEnabled="False"
                                                Padding="10,4" Margin="0,0,8,0"
                                                ToolTip="Colle les mécaniques copiées sur le monstre courant, sans modifier les textes ni l'ID localisé."/>
                                        <Button x:Name="RevertMonsterStatsButton" Content="↶ Annuler stats/drops"
                                                Click="OnRevertMonsterStats_Click" IsEnabled="False"
                                                Padding="10,4" Margin="0,0,8,0"
                                                ToolTip="Restaure les récompenses, drops et stats depuis l'état en mémoire du fichier monstre."/>
                                        <TextBlock x:Name="MonsterStatsEditStatusText" VerticalAlignment="Center"
                                                   Foreground="#666666" FontStyle="Italic"/>
                                    </WrapPanel>
                                </Border>

                                <GroupBox Header="Structure du fichier">
                                    <TextBlock x:Name="ChunksInfoText" FontFamily="Consolas" FontSize="11"/>
                                </GroupBox>

                                <TextBlock Margin="0,10,0,0" Foreground="#888888" FontStyle="Italic" TextWrapping="Wrap"
                                           Text="Note : les commandes restent affichées en lecture seule pour l'instant. Les récompenses, drops, stats, affinités, résistances, auto-statuts, immunités et métadonnées sont éditables."/>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

            <!-- ============ ONGLET ATTAQUES (monmagic1.bin + monmagic2.bin) ============ -->
            <TabItem x:Name="TabAttacks" Header="Attaques" IsEnabled="False">
                <DockPanel>
                    <!-- Sidebar gauche : liste des attaques -->
                    <Border DockPanel.Dock="Left" BorderBrush="#CCCCCC" BorderThickness="0,0,1,0" Width="280">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="6,6,6,0" LastChildFill="True">
                                <TextBlock Text="Source :" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox x:Name="AttackSourceSelector"
                                          SelectionChanged="OnAttackSource_Changed"
                                          ToolTip="Choisir entre monmagic1, monmagic2, ou les deux"/>
                            </DockPanel>
                            <UniformGrid DockPanel.Dock="Top" Columns="2" Margin="6,6,6,0">
                                <Button x:Name="AddMonMagic1EntryButton"
                                        Margin="0,0,3,0"
                                        Padding="6,3"
                                        Content="+ monmagic1"
                                        Click="OnAddMonMagic1Entry_Click"
                                        ToolTip="Clone 0x4000 vers une nouvelle entrée monmagic1"/>
                                <Button x:Name="AddMonMagic2EntryButton"
                                        Margin="3,0,0,0"
                                        Padding="6,3"
                                        Content="+ monmagic2"
                                        Click="OnAddMonMagic2Entry_Click"
                                        ToolTip="Clone 0x6000 vers une nouvelle entrée monmagic2"/>
                            </UniformGrid>
                            <Grid DockPanel.Dock="Top" Margin="6">
                                <TextBox x:Name="AttackFilterBox" Padding="4,3"
                                         TextChanged="OnAttackFilter_Changed"
                                         ToolTip="Filtrer (par ID ou nom de l'attaque)"/>
                                <TextBlock Text="🔍 Filtrer..." Foreground="#888888"
                                           Margin="8,0,0,0" VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           x:Name="AttackFilterPlaceholder"/>
                            </Grid>
                            <TextBlock DockPanel.Dock="Bottom" x:Name="AttackCountText"
                                       Margin="6,4" Foreground="#666666" FontSize="11"/>
                            <ListBox x:Name="AttackListBox"
                                     BorderThickness="0"
                                     SelectionChanged="OnAttackSelection_Changed"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                        </DockPanel>
                    </Border>

                    <!-- Panneau de droite : détails de l'attaque -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid Margin="20">
                            <TextBlock x:Name="NoAttackSelectedMessage"
                                       Text="← Sélectionne une attaque dans la liste pour voir ses propriétés."
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="Gray" FontStyle="Italic"/>

                            <StackPanel x:Name="AttackDetailsPanel" Visibility="Collapsed">
                                <TextBlock x:Name="AttackHeaderText" FontSize="20" FontWeight="Bold"/>
                                <TextBlock x:Name="AttackInfoText" Foreground="#666666" Margin="0,0,0,15"/>

                                <!-- Texte de l'attaque (nom + description) -->
                                <GroupBox x:Name="AttackTextsGroup" Header="Texte (langue sélectionnée dans l'onglet Monstres)">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Label   Grid.Row="0" Grid.Column="0" Content="Nom :"/>
                                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="AttackNameBox"
                                                 TextChanged="OnAttackText_Changed"
                                                 PreviewKeyDown="OnMonsterTextBox_KeyDown"/>
                                        <Label   Grid.Row="1" Grid.Column="0" Content="Nom (court) :"/>
                                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="AttackSimpleNameBox"
                                                 TextChanged="OnAttackText_Changed"
                                                 PreviewKeyDown="OnMonsterTextBox_KeyDown"/>
                                        <Label   Grid.Row="2" Grid.Column="0" Content="Description :" VerticalAlignment="Top" Margin="0,4,0,0"/>
                                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="AttackDescBox"
                                                 TextChanged="OnAttackText_Changed"
                                                 PreviewKeyDown="OnMonsterTextBox_KeyDown"
                                                 TextWrapping="Wrap" AcceptsReturn="True" MinHeight="40" MaxHeight="120"
                                                 VerticalScrollBarVisibility="Auto"/>
                                        <Label   Grid.Row="3" Grid.Column="0" Content="Desc. (court) :" VerticalAlignment="Top" Margin="0,4,0,0"/>
                                        <TextBox Grid.Row="3" Grid.Column="1" x:Name="AttackSimpleDescBox"
                                                 TextChanged="OnAttackText_Changed"
                                                 PreviewKeyDown="OnMonsterTextBox_KeyDown"
                                                 TextWrapping="Wrap" AcceptsReturn="True" MinHeight="30" MaxHeight="80"
                                                 VerticalScrollBarVisibility="Auto"/>
                                    </Grid>
                                </GroupBox>

                                <Border Margin="0,8,0,0" Padding="6" Background="#F5F5F5" CornerRadius="3">
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="ApplyAttackTextsButton" Content="✓ Appliquer les modifications"
                                                Click="OnApplyAttackTexts_Click" IsEnabled="False"
                                                Padding="10,4" Margin="0,0,8,0"
                                                ToolTip="Réencode les textes de l'attaque et marque monmagic pour la sauvegarde."/>
                                        <Button x:Name="RevertAttackTextsButton" Content="↶ Annuler"
                                                Click="OnRevertAttackTexts_Click" IsEnabled="False"
                                                Padding="10,4" Margin="0,0,8,0"
                                                ToolTip="Restaure les textes de l'attaque depuis l'état en mémoire."/>
                                        <TextBlock x:Name="AttackEditStatusText" VerticalAlignment="Center"
                                                   Foreground="#666666" FontStyle="Italic"/>
                                    </StackPanel>
                                </Border>

                                <!-- Stats principales -->
                                <GroupBox Header="Mécanique">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/><ColumnDefinition Width="100"/><ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="120"/><ColumnDefinition Width="100"/><ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="120"/><ColumnDefinition Width="100"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition/><RowDefinition/><RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <Label   Grid.Row="0" Grid.Column="0" Content="Puissance :"/>
                                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="AtkPowerBox" TextChanged="OnAttackMechanic_Changed"/>
                                        <Label   Grid.Row="0" Grid.Column="3" Content="Précision :"/>
                                        <TextBox Grid.Row="0" Grid.Column="4" x:Name="AtkAccuracyBox" TextChanged="OnAttackMechanic_Changed"/>
                                        <Label   Grid.Row="0" Grid.Column="6" Content="Coups :"/>
                                        <TextBox Grid.Row="0" Grid.Column="7" x:Name="AtkHitCountBox" TextChanged="OnAttackMechanic_Changed"/>

                                        <Label   Grid.Row="1" Grid.Column="0" Content="Formule (ID) :"/>
                                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="AtkFormulaBox" TextChanged="OnAttackMechanic_Changed"/>
                                        <Label   Grid.Row="1" Grid.Column="3" Content="Coût MP :"/>
                                        <TextBox Grid.Row="1" Grid.Column="4" x:Name="AtkCostMpBox" TextChanged="OnAttackMechanic_Changed"/>
                                        <Label   Grid.Row="1" Grid.Column="6" Content="Coût OD :"/>
                                        <TextBox Grid.Row="1" Grid.Column="7" x:Name="AtkCostOdBox" TextChanged="OnAttackMechanic_Changed"/>

                                        <Label   Grid.Row="2" Grid.Column="0" Content="Bonus crit. :"/>
                                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="AtkCritBox" TextChanged="OnAttackMechanic_Changed"/>
                                        <Label   Grid.Row="2" Grid.Column="3" Content="Pétrif. (%) :"/>
                                        <TextBox Grid.Row="2" Grid.Column="4" x:Name="AtkShatterBox" TextChanged="OnAttackMechanic_Changed"/>
                                        <Label   Grid.Row="2" Grid.Column="6" Content="Move rank :"/>
                                        <TextBox Grid.Row="2" Grid.Column="7" x:Name="AtkMoveRankBox" TextChanged="OnAttackMechanic_Changed"/>
                                    </Grid>
                                </GroupBox>

                                <GroupBox Header="Animation et octets avancés">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/><ColumnDefinition Width="100"/><ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="120"/><ColumnDefinition Width="100"/><ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="120"/><ColumnDefinition Width="100"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <Label   Grid.Row="0" Grid.Column="0" Content="Anim 1 :"/>
                                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="AtkAnim1Box" TextChanged="OnAttackMechanic_Changed"/>
                                        <Label   Grid.Row="0" Grid.Column="3" Content="Anim 2 :"/>
                                        <TextBox Grid.Row="0" Grid.Column="4" x:Name="AtkAnim2Box" TextChanged="OnAttackMechanic_Changed"/>
                                        <Label   Grid.Row="0" Grid.Column="6" Content="Icône :"/>
                                        <TextBox Grid.Row="0" Grid.Column="7" x:Name="AtkIconBox" TextChanged="OnAttackMechanic_Changed"/>

                                        <Label   Grid.Row="1" Grid.Column="0" Content="Anim caster :"/>
                                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="AtkCasterAnimationBox" TextChanged="OnAttackMechanic_Changed"/>
                                        <Label   Grid.Row="1" Grid.Column="3" Content="Menu 0x16 :"/>
                                        <TextBox Grid.Row="1" Grid.Column="4" x:Name="AtkMenuPropsBox" TextChanged="OnAttackMechanic_Changed"/>
                                        <Label   Grid.Row="1" Grid.Column="6" Content="Sous-menu A :"/>
                                        <TextBox Grid.Row="1" Grid.Column="7" x:Name="AtkSubsubMenuBox" TextChanged="OnAttackMechanic_Changed"/>

                                        <Label   Grid.Row="2" Grid.Column="0" Content="Sous-menu B :"/>
                                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="AtkSubMenuBox" TextChanged="OnAttackMechanic_Changed"/>
                                        <Label   Grid.Row="2" Grid.Column="3" Content="User char :"/>
                                        <TextBox Grid.Row="2" Grid.Column="4" x:Name="AtkCharacterUserBox" TextChanged="OnAttackMechanic_Changed"/>
                                        <Label   Grid.Row="2" Grid.Column="6" Content="Cibles perm. :"/>
                                        <TextBox Grid.Row="2" Grid.Column="7" x:Name="AtkTargetsAllowedBox" TextChanged="OnAttackMechanic_Changed"/>

                                        <Label   Grid.Row="3" Grid.Column="0" Content="Misc 0x1C :"/>
                                        <TextBox Grid.Row="3" Grid.Column="1" x:Name="AtkMisc1CBox" TextChanged="OnAttackMechanic_Changed"/>
                                        <Label   Grid.Row="3" Grid.Column="3" Content="Misc 0x1D :"/>
                                        <TextBox Grid.Row="3" Grid.Column="4" x:Name="AtkMisc1DBox" TextChanged="OnAttackMechanic_Changed"/>
                                        <Label   Grid.Row="3" Grid.Column="6" Content="Misc 0x1E :"/>
                                        <TextBox Grid.Row="3" Grid.Column="7" x:Name="AtkMisc1EBox" TextChanged="OnAttackMechanic_Changed"/>

                                        <Label   Grid.Row="4" Grid.Column="0" Content="Anim props :"/>
                                        <TextBox Grid.Row="4" Grid.Column="1" x:Name="AtkAnimPropsBox" TextChanged="OnAttackMechanic_Changed"/>
                                        <Label   Grid.Row="4" Grid.Column="3" Content="Steal/Gil :"/>
                                        <TextBox Grid.Row="4" Grid.Column="4" x:Name="AtkStealGilBox" TextChanged="OnAttackMechanic_Changed"/>
                                        <Label   Grid.Row="4" Grid.Column="6" Content="Preview :"/>
                                            <TextBox Grid.Row="4" Grid.Column="7" x:Name="AtkPartyPreviewBox" TextChanged="OnAttackMechanic_Changed"/>
                                        </Grid>
                                    </GroupBox>

                                <GroupBox Header="Flags avancés">
                                    <StackPanel>
                                        <TextBlock Text="Disponibilité / calcul de toucher" FontWeight="Bold" Margin="0,0,0,2"/>
                                        <WrapPanel x:Name="AtkMisc1CFlagsPanel" Margin="0,0,0,6"/>
                                        <TextBlock Text="Menus / effets CTB" FontWeight="Bold" Margin="0,2,0,2"/>
                                        <WrapPanel x:Name="AtkMisc1DFlagsPanel" Margin="0,0,0,6"/>
                                        <TextBlock Text="Exécution" FontWeight="Bold" Margin="0,2,0,2"/>
                                        <WrapPanel x:Name="AtkMisc1EFlagsPanel" Margin="0,0,0,6"/>
                                        <TextBlock Text="Animation / Overdrive" FontWeight="Bold" Margin="0,2,0,2"/>
                                        <WrapPanel x:Name="AtkAnimFlagsPanel"/>
                                    </StackPanel>
                                </GroupBox>

                                <!-- Type de dégâts + classe + crit -->
                                <GroupBox Header="Type de dégâts">
                                    <StackPanel>
                                        <WrapPanel x:Name="AtkDamagePropsPanel" Margin="0,0,0,4"/>
                                        <WrapPanel x:Name="AtkDamageClassPanel"/>
                                    </StackPanel>
                                </GroupBox>

                                <!-- Cibles -->
                                <GroupBox Header="Ciblage">
                                    <WrapPanel x:Name="AtkTargetingPanel"/>
                                </GroupBox>

                                <!-- Éléments -->
                                <GroupBox Header="Éléments infligés">
                                    <WrapPanel x:Name="AtkElementsPanel"/>
                                </GroupBox>

                                <!-- Statuts infligés (chances + durées) -->
                                <GroupBox Header="Statuts infligés (chance + durée si applicable)">
                                    <Grid x:Name="AtkStatusGrid"/>
                                </GroupBox>

                                <!-- Statuts extras -->
                                <GroupBox Header="Effets spéciaux (Scan, Boost, Distill, Doom, ...)">
                                    <StackPanel>
                                        <WrapPanel x:Name="AtkExtraStatusPanel"/>
                                        <TextBlock Text="Buffs stats" FontWeight="Bold" Margin="0,8,0,2"/>
                                        <WrapPanel x:Name="AtkStatBuffPanel"/>
                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150"/><ColumnDefinition Width="100"/><ColumnDefinition Width="20"/>
                                                <ColumnDefinition Width="150"/><ColumnDefinition Width="100"/><ColumnDefinition Width="20"/>
                                                <ColumnDefinition Width="150"/><ColumnDefinition Width="100"/>
                                            </Grid.ColumnDefinitions>
                                            <Label   Grid.Column="0" Content="Valeur buff :"/>
                                            <TextBox Grid.Column="1" x:Name="AtkStatBuffValueBox" TextChanged="OnAttackMechanic_Changed"/>
                                            <Label   Grid.Column="3" Content="OD catégorie :"/>
                                            <TextBox Grid.Column="4" x:Name="AtkOverdriveCategoryBox" TextChanged="OnAttackMechanic_Changed"/>
                                            <Label   Grid.Column="6" Content="Buff spécial :"/>
                                            <TextBox Grid.Column="7" x:Name="AtkSpecialBuffBox" TextChanged="OnAttackMechanic_Changed"/>
                                        </Grid>
                                    </StackPanel>
                                </GroupBox>

                                <Border Margin="0,8,0,0" Padding="6" Background="#F5F5F5" CornerRadius="3">
                                    <WrapPanel>
                                        <Button x:Name="ApplyAttackMechanicsButton" Content="✓ Appliquer les mécaniques"
                                                Click="OnApplyAttackMechanics_Click" IsEnabled="False"
                                                Padding="10,4" Margin="0,0,8,0"
                                                ToolTip="Applique les valeurs mécaniques à monmagic1/2 en mémoire."/>
                                        <Button x:Name="CopyAttackMechanicsButton" Content="⧉ Copier"
                                                Click="OnCopyAttackMechanics_Click" IsEnabled="False"
                                                Padding="10,4" Margin="0,0,8,0"
                                                ToolTip="Copie les mécaniques de l'attaque sélectionnée, sans copier son nom ni sa description."/>
                                        <Button x:Name="PasteAttackMechanicsButton" Content="⤓ Coller"
                                                Click="OnPasteAttackMechanics_Click" IsEnabled="False"
                                                Padding="10,4" Margin="0,0,8,0"
                                                ToolTip="Colle les mécaniques copiées sur l'attaque sélectionnée, sans modifier son nom ni sa description."/>
                                        <Button x:Name="ApplyAttackMechanicsAllLanguagesButton" Content="⇄ Toutes langues"
                                                Click="OnApplyAttackMechanicsAllLanguages_Click" IsEnabled="False"
                                                Padding="10,4" Margin="0,0,8,0"
                                                ToolTip="Applique uniquement les mécaniques de cette attaque à toutes les langues chargées."/>
                                        <Button x:Name="ApplyAllAttackMechanicsAllLanguagesButton" Content="⇄ Toutes entrées"
                                                Click="OnApplyAllAttackMechanicsAllLanguages_Click" IsEnabled="False"
                                                Padding="10,4" Margin="0,0,8,0"
                                                ToolTip="Copie les mécaniques de toutes les attaques de la langue courante vers les autres langues, sans modifier noms ni descriptions."/>
                                        <Button x:Name="RevertAttackMechanicsButton" Content="↶ Annuler mécaniques"
                                                Click="OnRevertAttackMechanics_Click" IsEnabled="False"
                                                Padding="10,4" Margin="0,0,8,0"
                                                ToolTip="Restaure les mécaniques depuis l'état en mémoire."/>
                                        <TextBlock x:Name="AttackMechanicsStatusText" VerticalAlignment="Center"
                                                   Foreground="#666666" FontStyle="Italic"/>
                                    </WrapPanel>
                                </Border>

                                <TextBlock Margin="0,10,0,0" Foreground="#888888" FontStyle="Italic" TextWrapping="Wrap"
                                           Text="Les champs numériques acceptent le décimal ou l'hexadécimal au format 0x.. ."/>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

            <!-- ============ ONGLET IA MONSTRES ============ -->
            <TabItem x:Name="TabMonsterAi" Header="IA Monstres" IsEnabled="False">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#F7F7F7" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Monstre :" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,6,0"/>
                            <ComboBox x:Name="MonsterAiMonsterSelector"
                                      Width="360"
                                      SelectionChanged="OnMonsterAiMonster_SelectionChanged"
                                      ToolTip="Choisir le fichier monstre dont afficher le bytecode ATEL"/>
                            <Button Content="↻ Rafraîchir"
                                    Click="OnRefreshMonsterAi_Click"
                                    Padding="10,4"
                                    Margin="8,0,0,0"
                                    ToolTip="Relit l'IA du monstre sélectionné en mémoire"/>
                        </StackPanel>
                    </Border>

                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock x:Name="MonsterAiHeaderText" FontSize="18" FontWeight="Bold" Text="Décompilation ATEL"/>
                            <TextBlock x:Name="MonsterAiSummaryText" Foreground="#666666" TextWrapping="Wrap"/>
                        </StackPanel>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="360"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <GroupBox Grid.Column="0" Header="Workers">
                                <ListView x:Name="MonsterAiWorkersList"
                                          FontFamily="Consolas"
                                          ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="W" Width="42" DisplayMemberBinding="{Binding Label}"/>
                                            <GridViewColumn Header="Type" Width="90" DisplayMemberBinding="{Binding KindLabel}"/>
                                            <GridViewColumn Header="Fn" Width="42" DisplayMemberBinding="{Binding FunctionCount}"/>
                                            <GridViewColumn Header="Jmp" Width="42" DisplayMemberBinding="{Binding JumpCount}"/>
                                            <GridViewColumn Header="Vars" Width="46" DisplayMemberBinding="{Binding VariableCount}"/>
                                            <GridViewColumn Header="Fonctions" Width="280" DisplayMemberBinding="{Binding FunctionsLabel}"/>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </GroupBox>

                            <GroupBox Grid.Column="2" Header="IA ATEL (lecture seule)">
                                <TabControl>
                                    <TabItem Header="Analyse">
                                        <TextBox x:Name="MonsterAiAnalysisBox"
                                                 FontFamily="Segoe UI"
                                                 FontSize="12"
                                                 IsReadOnly="True"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 VerticalScrollBarVisibility="Auto"
                                                 HorizontalScrollBarVisibility="Auto"/>
                                    </TabItem>
                                    <TabItem Header="Copilote">
                                        <Grid Margin="4">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <Border Grid.Row="0" Margin="0,0,0,8" Padding="6" Background="#F5F5F5" CornerRadius="3">
                                                <WrapPanel VerticalAlignment="Center">
                                                    <CheckBox x:Name="MonsterAiUseLlmCheckBox"
                                                              Content="LLM"
                                                              VerticalAlignment="Center"
                                                              Margin="0,0,10,0"/>
                                                    <TextBlock Text="Endpoint" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                    <TextBox x:Name="MonsterAiLlmEndpointBox"
                                                             Width="270"
                                                             Margin="0,0,8,0"
                                                             ToolTip="Endpoint compatible chat completions"/>
                                                    <TextBlock Text="Modèle" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                    <TextBox x:Name="MonsterAiLlmModelBox"
                                                             Width="150"
                                                             Margin="0,0,8,0"/>
                                                    <TextBlock Text="Clé" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                    <PasswordBox x:Name="MonsterAiLlmApiKeyBox"
                                                                 Width="150"
                                                                 Margin="0,0,8,0"
                                                                 ToolTip="Non sauvegardée"/>
                                                    <Button Content="Enregistrer"
                                                            Click="OnMonsterAiLlmSaveSettings_Click"
                                                            Padding="8,3"
                                                            Margin="0,0,8,0"/>
                                                    <Button Content="Test"
                                                            Click="OnMonsterAiLlmTest_Click"
                                                            Padding="8,3"
                                                            Margin="0,0,8,0"/>
                                                    <Button x:Name="MonsterAiBuildIndexButton"
                                                            Content="Indexer ATEL"
                                                            Click="OnMonsterAiBuildIndex_Click"
                                                            Padding="8,3"
                                                            Margin="0,0,8,0"
                                                            ToolTip="Lit tous les fichiers mon disponibles pour fournir des exemples globaux au copilote."/>
                                                    <ProgressBar x:Name="MonsterAiIndexProgressBar"
                                                                 Width="90"
                                                                 Height="10"
                                                                 Minimum="0"
                                                                 Maximum="100"
                                                                 Visibility="Collapsed"
                                                                 Margin="0,0,8,0"
                                                                 VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="MonsterAiLlmStatusText"
                                                               VerticalAlignment="Center"
                                                               Foreground="#666666"
                                                               FontStyle="Italic"
                                                               Margin="0,0,8,0"/>
                                                    <TextBlock x:Name="MonsterAiIndexStatusText"
                                                               VerticalAlignment="Center"
                                                               Foreground="#666666"
                                                               FontStyle="Italic"/>
                                                </WrapPanel>
                                            </Border>

                                            <TextBox x:Name="MonsterAiCopilotOutputBox"
                                                     Grid.Row="1"
                                                     FontFamily="Segoe UI"
                                                     FontSize="12"
                                                     IsReadOnly="True"
                                                     AcceptsReturn="True"
                                                     TextWrapping="Wrap"
                                                     VerticalScrollBarVisibility="Auto"
                                                     HorizontalScrollBarVisibility="Auto"/>

                                            <Border Grid.Row="2" Margin="0,8,0,0" Padding="6" Background="#F5F5F5" CornerRadius="3">
                                                <DockPanel LastChildFill="True">
                                                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                                        <Button Content="Résumé"
                                                                Tag="Résume ce monstre."
                                                                Click="OnMonsterAiCopilotQuickAsk_Click"
                                                                Padding="8,3"
                                                                Margin="0,0,6,4"/>
                                                        <Button Content="Actions"
                                                                Tag="Liste les actions et commandes importantes."
                                                                Click="OnMonsterAiCopilotQuickAsk_Click"
                                                                Padding="8,3"
                                                                Margin="0,0,6,4"/>
                                                        <Button Content="Counters"
                                                                Tag="Où sont les réactions ou counters ?"
                                                                Click="OnMonsterAiCopilotQuickAsk_Click"
                                                                Padding="8,3"
                                                                Margin="0,0,6,4"/>
                                                        <Button Content="Plan de modif"
                                                                Tag="Propose un plan prudent pour modifier cette IA."
                                                                Click="OnMonsterAiCopilotQuickAsk_Click"
                                                                Padding="8,3"
                                                                Margin="0,0,6,4"/>
                                                    </WrapPanel>

                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>

                                                        <TextBox x:Name="MonsterAiCopilotInputBox"
                                                                 Grid.Row="0"
                                                                 Grid.Column="0"
                                                                 MinHeight="54"
                                                                 AcceptsReturn="True"
                                                                 TextWrapping="Wrap"
                                                                 VerticalScrollBarVisibility="Auto"
                                                                 KeyDown="OnMonsterAiCopilotInput_KeyDown"
                                                                 ToolTip="Pose une question au copilote local. Ctrl+Entrée pour envoyer."/>
                                                        <Button x:Name="MonsterAiCopilotAskButton"
                                                                Grid.Row="0"
                                                                Grid.Column="1"
                                                                Content="Demander"
                                                                Click="OnMonsterAiCopilotAsk_Click"
                                                                Padding="12,4"
                                                                Margin="6,0,0,0"
                                                                VerticalAlignment="Stretch"/>
                                                        <Button x:Name="MonsterAiCopilotPatchButton"
                                                                Grid.Row="0"
                                                                Grid.Column="2"
                                                                Content="Prétester patch LLM"
                                                                Click="OnMonsterAiCopilotPatch_Click"
                                                                Padding="12,4"
                                                                Margin="6,0,0,0"
                                                                VerticalAlignment="Stretch"
                                                                ToolTip="Nécessite LLM actif. Demande au LLM un patch ATEL JSON structuré, le valide, puis propose de l'appliquer."/>
                                                        <TextBlock Grid.Row="1"
                                                                   Grid.ColumnSpan="3"
                                                                   Margin="0,5,0,0"
                                                                   Foreground="#666666"
                                                                   FontStyle="Italic"
                                                                   TextWrapping="Wrap"
                                                                   Text="Copilote : analyse locale ou LLM optionnel. L'édition déterministe ci-dessous ne nécessite pas de LLM."/>
                                                        <Border Grid.Row="2"
                                                                Grid.ColumnSpan="3"
                                                                Margin="0,8,0,0"
                                                                Padding="6"
                                                                Background="#FFFFFF"
                                                                BorderBrush="#DDDDDD"
                                                                BorderThickness="1">
                                                            <WrapPanel VerticalAlignment="Center">
                                                                <TextBlock Text="Remplacer commande ATEL"
                                                                           FontWeight="Bold"
                                                                           VerticalAlignment="Center"
                                                                           Margin="0,0,10,0"/>
                                                                <TextBlock Text="De"
                                                                           VerticalAlignment="Center"
                                                                           Margin="0,0,4,0"/>
                                                                <TextBox x:Name="MonsterAiReplaceOldCommandBox"
                                                                         Width="82"
                                                                         Margin="0,0,8,0"
                                                                         ToolTip="ID global, ex : 0x3044"/>
                                                                <TextBlock Text="vers"
                                                                           VerticalAlignment="Center"
                                                                           Margin="0,0,4,0"/>
                                                                <TextBox x:Name="MonsterAiReplaceNewCommandBox"
                                                                         Width="82"
                                                                         Margin="0,0,8,0"
                                                                         ToolTip="ID global, ex : 0x3048"/>
                                                                <Button x:Name="MonsterAiReplaceCommandButton"
                                                                        Content="Prétester et appliquer"
                                                                        Click="OnMonsterAiReplaceCommand_Click"
                                                                        Padding="8,3"
                                                                        Margin="0,0,8,0"
                                                                        ToolTip="Remplace les constantes de commande immédiates repérées avant performCommand/addCommand, avec prétest interne."/>
                                                                <TextBlock x:Name="MonsterAiDeterministicEditStatusText"
                                                                           Foreground="#666666"
                                                                           FontStyle="Italic"
                                                                           VerticalAlignment="Center"/>
                                                            </WrapPanel>
                                                        </Border>
                                                    </Grid>
                                                </DockPanel>
                                            </Border>
                                        </Grid>
                                    </TabItem>
                                    <TabItem Header="Listing brut">
                                        <TextBox x:Name="MonsterAiCodeBox"
                                                 FontFamily="Consolas"
                                                 FontSize="12"
                                                 IsReadOnly="True"
                                                 AcceptsReturn="True"
                                                 AcceptsTab="True"
                                                 TextWrapping="NoWrap"
                                                 VerticalScrollBarVisibility="Auto"
                                                 HorizontalScrollBarVisibility="Auto"/>
                                    </TabItem>
                                </TabControl>
                            </GroupBox>
                        </Grid>
                    </Grid>
                </DockPanel>
            </TabItem>

            <!-- ============ ONGLET ENCOUNTERS / SCÈNES DE COMBAT ============ -->
            <TabItem x:Name="TabEncounters" Header="Scènes de combat" IsEnabled="False">
                <DockPanel>
                    <!-- ========== SIDEBAR : LISTE DES ZONES ========== -->
                    <Border DockPanel.Dock="Left" BorderBrush="#CCCCCC" BorderThickness="0,0,1,0" Width="280">
                        <DockPanel>
                            <ComboBox DockPanel.Dock="Top" x:Name="EncounterCategoryFilter"
                                      Margin="6,6,6,0"
                                      SelectionChanged="OnEncounterCategoryFilter_Changed"
                                      ToolTip="Filtrer les zones par type de rencontre">
                                <ComboBoxItem Content="Toutes les zones" IsSelected="True" Tag="all"/>
                                <ComboBoxItem Content="🎲 Avec rencontres aléatoires" Tag="random"/>
                                <ComboBoxItem Content="📜 Avec rencontres scriptées" Tag="scripted"/>
                                <ComboBoxItem Content="🎲📜 Mixtes (les deux)" Tag="mixed"/>
                            </ComboBox>
                            <Grid DockPanel.Dock="Top" Margin="6">
                                <TextBox x:Name="EncounterFilterBox" Padding="4,3"
                                         TextChanged="OnEncounterFilter_Changed"
                                         ToolTip="Filtrer par nom de carte"/>
                                <TextBlock Text="🔍 Filtrer..." Foreground="#888888"
                                           Margin="8,0,0,0" VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           x:Name="EncounterFilterPlaceholder"/>
                            </Grid>
                            <TextBlock DockPanel.Dock="Bottom" x:Name="EncounterCountText"
                                       Margin="6,4" Foreground="#666666" FontSize="11"/>
                            <ListBox x:Name="EncounterListBox"
                                     BorderThickness="0"
                                     SelectionChanged="OnEncounterSelection_Changed"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                        </DockPanel>
                    </Border>

                    <!-- ========== DÉTAIL ZONE ========== -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid Margin="20">
                            <TextBlock x:Name="NoEncounterSelectedMessage"
                                       Text="← Sélectionne une zone dans la liste pour voir ses rencontres."
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="Gray" FontStyle="Italic"/>

                            <StackPanel x:Name="EncounterDetailsPanel" Visibility="Collapsed">
                                <TextBlock x:Name="EncounterHeaderText" FontSize="20" FontWeight="Bold"/>
                                <TextBlock x:Name="EncounterInfoText" Foreground="#666666" Margin="0,0,0,15"/>

                                <!-- Bloc Rencontres ALÉATOIRES -->
                                <GroupBox x:Name="EncounterRandomGroup" Header="🎲 Rencontres aléatoires">
                                    <StackPanel x:Name="EncounterRandomGroupsPanel"/>
                                </GroupBox>

                                <!-- Bloc Rencontres SCRIPTÉES -->
                                <GroupBox x:Name="EncounterScriptedGroup" Header="📜 Rencontres scriptées (déclenchées par event)">
                                    <StackPanel x:Name="EncounterScriptedGroupsPanel"/>
                                </GroupBox>

                                <!-- Bloc Détails de la scène sélectionnée -->
                                <GroupBox x:Name="BattleSceneDetailsGroup" Header="🎬 Détails de la scène"
                                          Visibility="Collapsed" Margin="0,10,0,0">
                                    <StackPanel>
                                        <TextBlock x:Name="BattleSceneHeaderText" FontWeight="Bold" FontSize="14"
                                                   Margin="0,0,0,4"/>
                                        <TextBlock x:Name="BattleSceneSummaryText" Foreground="#666666"
                                                   Margin="0,0,0,10" TextWrapping="Wrap"/>

                                        <!-- Capacité de la scène -->
                                        <Border BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="3"
                                                Padding="8,4" Margin="0,0,0,10" Background="#F7F7F7">
                                            <TextBlock x:Name="BattleSceneCapacityText" FontSize="11"
                                                       Foreground="#444444" TextWrapping="Wrap"/>
                                        </Border>

                                        <GroupBox x:Name="BattleSceneEditGroup" Header="Édition simple — formation et positions"
                                                  Margin="0,0,0,10">
                                            <StackPanel>
                                                <WrapPanel Margin="0,0,0,8">
                                                    <CheckBox x:Name="BattleSceneInWaterCheck"
                                                              Content="Combat sous-marin"
                                                              Margin="0,0,18,0"
                                                              Checked="OnBattleSceneEdit_Changed"
                                                              Unchecked="OnBattleSceneEdit_Changed"/>
                                                    <CheckBox x:Name="BattleSceneVoicesCheck"
                                                              Content="Lignes de voix communes"
                                                              Checked="OnBattleSceneEdit_Changed"
                                                              Unchecked="OnBattleSceneEdit_Changed"/>
                                                </WrapPanel>

                                                <TextBlock x:Name="BattleSceneEditCountText"
                                                           Foreground="#666666" FontSize="11"
                                                           Margin="0,0,0,6" TextWrapping="Wrap"/>

                                                <TextBlock Text="Slots monstres"
                                                           FontWeight="SemiBold" Margin="0,0,0,2"/>
                                                <Grid x:Name="BattleSceneFormationEditGrid"/>

                                                <Expander Header="Positions des monstres"
                                                          IsExpanded="True"
                                                          Margin="0,8,0,0">
                                                    <Grid x:Name="BattleSceneMonsterPositionEditGrid"/>
                                                </Expander>

                                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                                    <Button x:Name="ApplyBattleSceneButton"
                                                            Content="✓ Appliquer scène"
                                                            Click="OnApplyBattleScene_Click"
                                                            IsEnabled="False"
                                                            Margin="0,0,6,0"/>
                                                    <Button x:Name="RevertBattleSceneButton"
                                                            Content="↶ Annuler"
                                                            Click="OnRevertBattleScene_Click"
                                                            IsEnabled="False"
                                                            Margin="0,0,12,0"/>
                                                    <TextBlock x:Name="BattleSceneEditStatusText"
                                                               VerticalAlignment="Center"
                                                               Foreground="#666666"
                                                               TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </GroupBox>

                                        <!-- Liste des monstres -->
                                        <TextBlock Text="👹 Monstres dans la formation :" FontWeight="SemiBold" Margin="0,4,0,2"/>
                                        <ItemsControl x:Name="BattleSceneMonstersList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,1,0,1">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="40"/>
                                                            <ColumnDefinition Width="80"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="220"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding SlotLabel}"
                                                                   FontWeight="SemiBold"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding HexId}"
                                                                   FontFamily="Consolas" Foreground="#666666"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding MonsterName}"/>
                                                        <TextBlock Grid.Column="3" Text="{Binding Position}"
                                                                   FontFamily="Consolas" Foreground="#888888" FontSize="11"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Positions des personnages -->
                                        <Expander x:Name="BattleScenePartyExpander" Header="👤 Positions des personnages joueurs"
                                                  Margin="0,10,0,0">
                                            <ItemsControl x:Name="BattleScenePartyList">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,1,0,1">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="60"/>
                                                                <ColumnDefinition Width="220"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding SlotLabel}" FontWeight="SemiBold"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding Position}"
                                                                       FontFamily="Consolas" Foreground="#666666" FontSize="11"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding SwitchPosition}"
                                                                       FontFamily="Consolas" Foreground="#999999" FontSize="11"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Expander>

                                        <!-- Positions des Chimères -->
                                        <Expander x:Name="BattleSceneAeonExpander" Header="✨ Positions des Chimères"
                                                  Margin="0,4,0,0">
                                            <ItemsControl x:Name="BattleSceneAeonList">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,1,0,1">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="60"/>
                                                                <ColumnDefinition Width="220"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding SlotLabel}" FontWeight="SemiBold"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding Position}"
                                                                       FontFamily="Consolas" Foreground="#666666" FontSize="11"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding SwitchPosition}"
                                                                       FontFamily="Consolas" Foreground="#999999" FontSize="11"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Expander>

                                        <!-- Infos supplémentaires -->
                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="200"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Combat sous-marin :"/>
                                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="BattleSceneInWaterText"/>
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Lignes de voix communes :"/>
                                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="BattleSceneVoicesText"/>
                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Zones (areas) :"/>
                                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="BattleSceneAreasText"/>
                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Taille du script ATEL :"/>
                                            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="BattleSceneAtelSizeText"/>
                                        </Grid>

                                        <TextBlock Margin="0,8,0,0" Foreground="#888888" FontStyle="Italic"
                                                   TextWrapping="Wrap" FontSize="11"
                                                   Text="L'IA ATEL de la scène (bytecode) sera décodée dans une prochaine version. Pour l'instant, seule sa taille est affichée."/>
                                    </StackPanel>
                                </GroupBox>

                                <TextBlock Margin="0,10,0,0" Foreground="#888888" FontStyle="Italic" TextWrapping="Wrap"
                                           Text="💡 Astuce : clique sur un fichier de bataille (.bin) dans les tableaux ci-dessus pour voir le détail de la scène."/>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

            <!-- ============ ONGLET COMMANDES JOUEURS / CHIMÈRES (command.bin) ============ -->
            <TabItem x:Name="TabCommands" Header="Commandes joueurs &amp; Chimères" IsEnabled="False">
                <DockPanel>
                    <!-- Sidebar gauche -->
                    <Border DockPanel.Dock="Left" BorderBrush="#CCCCCC" BorderThickness="0,0,1,0" Width="320">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="6,6,6,0" LastChildFill="True">
                                <TextBlock Text="Catégorie :" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox x:Name="CommandCategorySelector"
                                          SelectionChanged="OnCommandCategory_Changed"
                                          ToolTip="Filtrer par catégorie de commande"/>
                            </DockPanel>

                                        <Label   Grid.Row="2" Grid.Column="0" Content="Sous-menu B :"/>
                                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="ItemSubMenuBox" TextChanged="OnItemMechanic_Changed"/>
                                        <Label   Grid.Row="2" Grid.Column="3" Content="User char :"/>
                                        <TextBox Grid.Row="2" Grid.Column="4" x:Name="ItemCharacterUserBox" TextChanged="OnItemMechanic_Changed"/>
                                        <Label   Grid.Row="2" Grid.Column="6" Content="Cibles perm. :"/>
                                        <TextBox Grid.Row="2" Grid.Column="7" x:Name="ItemTargetsAllowedBox" TextChanged="OnItemMechanic_Changed"/>

                                        <Label   Grid.Row="3" Grid.Column="0" Content="Misc 0x1C :"/>
                                        <TextBox Grid.Row="3" Grid.Column="1" x:Name="ItemMisc1CBox" TextChanged="OnItemMechanic_Changed"/>
                                        <Label   Grid.Row="3" Grid.Column="3" Content="Misc 0x1D :"/>
                                        <TextBox Grid.Row="3" Grid.Column="4" x:Name="ItemMisc1DBox" TextChanged="OnItemMechanic_Changed"/>
                                        <Label   Grid.Row="3" Grid.Column="6" Content="Misc 0x1E :"/>
                                        <TextBox Grid.Row="3" Grid.Column="7" x:Name="ItemMisc1EBox" TextChanged="OnItemMechanic_Changed"/>

                                        <Label   Grid.Row="4" Grid.Column="0" Content="Anim props :"/>
                                        <TextBox Grid.Row="4" Grid.Column="1" x:Name="ItemAnimPropsBox" TextChanged="OnItemMechanic_Changed"/>
                                        <Label   Grid.Row="4" Grid.Column="3" Content="Steal/Gil :"/>
                                        <TextBox Grid.Row="4" Grid.Column="4" x:Name="ItemStealGilBox" TextChanged="OnItemMechanic_Changed"/>
                                        <Label   Grid.Row="4" Grid.Column="6" Content="Preview :"/>
                                        <TextBox Grid.Row="4" Grid.Column="7" x:Name="ItemPartyPreviewBox" TextChanged="OnItemMechanic_Changed"/>
                                    </Grid>
                                </GroupBox>

                                <GroupBox Header="Flags avancés">
                                    <StackPanel>
                                        <TextBlock Text="Disponibilité / calcul de toucher" FontWeight="Bold" Margin="0,0,0,2"/>
                                        <WrapPanel x:Name="ItemMisc1CFlagsPanel" Margin="0,0,0,6"/>
                                        <TextBlock Text="Menus / effets CTB" FontWeight="Bold" Margin="0,2,0,2"/>
                                        <WrapPanel x:Name="ItemMisc1DFlagsPanel" Margin="0,0,0,6"/>
                                        <TextBlock Text="Exécution" FontWeight="Bold" Margin="0,2,0,2"/>
                                        <WrapPanel x:Name="ItemMisc1EFlagsPanel" Margin="0,0,0,6"/>
                                        <TextBlock Text="Animation / Overdrive" FontWeight="Bold" Margin="0,2,0,2"/>
                                        <WrapPanel x:Name="ItemAnimFlagsPanel"/>
                                    </StackPanel>
                                </GroupBox>

                                <GroupBox Header="Type d'effet">
                                    <StackPanel>
                                        <WrapPanel x:Name="ItemDamagePropsPanel" Margin="0,0,0,4"/>
                                        <WrapPanel x:Name="ItemDamageClassPanel"/>
                                    </StackPanel>
                                </GroupBox>

                                <GroupBox Header="Ciblage">
                                    <WrapPanel x:Name="ItemTargetingPanel"/>
                                </GroupBox>

                                <GroupBox Header="Éléments infligés">
                                    <WrapPanel x:Name="ItemElementsPanel"/>
                                </GroupBox>

                                <GroupBox Header="Statuts (chance + durée)">
                                    <Grid x:Name="ItemStatusGrid"/>
                                </GroupBox>

                                <GroupBox Header="Effets spéciaux (Scan, Boost, Distill, Doom, ...)">
                                    <StackPanel>
                                        <WrapPanel x:Name="ItemExtraStatusPanel"/>
                                        <TextBlock Text="Buffs stats" FontWeight="Bold" Margin="0,8,0,2"/>
                                        <WrapPanel x:Name="ItemStatBuffPanel"/>
                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150"/><ColumnDefinition Width="100"/><ColumnDefinition Width="20"/>
                                                <ColumnDefinition Width="150"/><ColumnDefinition Width="100"/><ColumnDefinition Width="20"/>
                                                <ColumnDefinition Width="150"/><ColumnDefinition Width="100"/>
                                            </Grid.ColumnDefinitions>
                                            <Label   Grid.Column="0" Content="Valeur buff :"/>
                                            <TextBox Grid.Column="1" x:Name="ItemStatBuffValueBox" TextChanged="OnItemMechanic_Changed"/>
                                            <Label   Grid.Column="3" Content="OD catégorie :"/>
                                            <TextBox Grid.Column="4" x:Name="ItemOverdriveCategoryBox" TextChanged="OnItemMechanic_Changed"/>
                                            <Label   Grid.Column="6" Content="Buff spécial :"/>
                                            <TextBox Grid.Column="7" x:Name="ItemSpecialBuffBox" TextChanged="OnItemMechanic_Changed"/>
                                        </Grid>
                                    </StackPanel>
                                </GroupBox>

                                <Border Margin="0,8,0,0" Padding="6" Background="#F5F5F5" CornerRadius="3">
                                    <WrapPanel>
                                        <Button x:Name="ApplyItemMechanicsButton" Content="✓ Appliquer les mécaniques"
                                                Click="OnApplyItemMechanics_Click" IsEnabled="False"
                                                Padding="10,4" Margin="0,0,8,0"
                                                ToolTip="Applique les valeurs mécaniques à item.bin en mémoire."/>
                                        <Button x:Name="CopyItemMechanicsButton" Content="⧉ Copier"
                                                Click="OnCopyItemMechanics_Click" IsEnabled="False"
                                                Padding="10,4" Margin="0,0,8,0"
                                                ToolTip="Copie les mécaniques de l'objet sélectionné, sans copier son nom ni sa description."/>
                                        <Button x:Name="PasteItemMechanicsButton" Content="⤓ Coller"
                                                Click="OnPasteItemMechanics_Click" IsEnabled="False"
                                                Padding="10,4" Margin="0,0,8,0"
                                                ToolTip="Colle les mécaniques copiées sur l'objet sélectionné, sans modifier son nom ni sa description."/>
                                        <Button x:Name="ApplyItemMechanicsAllLanguagesButton" Content="⇄ Toutes langues"
                                                Click="OnApplyItemMechanicsAllLanguages_Click" IsEnabled="False"
                                                Padding="10,4" Margin="0,0,8,0"
                                                ToolTip="Applique uniquement les mécaniques de cet objet à toutes les langues chargées."/>
                                        <Button x:Name="ApplyAllItemMechanicsAllLanguagesButton" Content="⇄ Toutes entrées"
                                                Click="OnApplyAllItemMechanicsAllLanguages_Click" IsEnabled="False"
                                                Padding="10,4" Margin="0,0,8,0"
                                                ToolTip="Copie les mécaniques de tous les objets de la langue courante vers les autres langues, sans modifier noms ni descriptions."/>
                                        <Button x:Name="RevertItemMechanicsButton" Content="↶ Annuler mécaniques"
                                                Click="OnRevertItemMechanics_Click" IsEnabled="False"
                                                Padding="10,4" Margin="0,0,8,0"
                                                ToolTip="Restaure les mécaniques depuis l'état en mémoire."/>
                                        <TextBlock x:Name="ItemMechanicsStatusText" VerticalAlignment="Center"
                                                   Foreground="#666666" FontStyle="Italic"/>
                                    </WrapPanel>
                                </Border>

                                <TextBlock Margin="0,10,0,0" Foreground="#888888" FontStyle="Italic" TextWrapping="Wrap"
                                           Text="Les champs numériques acceptent le décimal ou l'hexadécimal au format 0x.. ."/>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

            <!-- ============ ONGLET ÉQUIPEMENTS ============ -->
            <TabItem x:Name="TabEquipment" Header="Équipements" IsEnabled="False">
                <DockPanel>
                    <Border DockPanel.Dock="Left" BorderBrush="#CCCCCC" BorderThickness="0,0,1,0" Width="320">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="6,6,6,0" LastChildFill="True">
                                <TextBlock Text="Source :" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox x:Name="GearSourceSelector"
                                          SelectionChanged="OnGearSource_Changed"
                                          ToolTip="Choisir entre buki_get (drops/coffres), shop_arms (boutique) ou les deux"/>
                            </DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="6,4,6,0" LastChildFill="True">
                                <TextBlock Text="Type :" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox x:Name="GearTypeSelector"
                                          SelectionChanged="OnGearType_Changed"
                                          ToolTip="Filtrer armes ou armures"/>
                            </DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="6,4,6,0" LastChildFill="True">
                                <TextBlock Text="Personnage :" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox x:Name="GearCharacterSelector"
                                          SelectionChanged="OnGearCharacter_Changed"
                                          ToolTip="Filtrer par personnage / Chimère"/>
                            </DockPanel>
                            <CheckBox x:Name="GearShowNamesCheckbox" DockPanel.Dock="Top"
                                      Margin="8,6,6,0" Content="Afficher les noms d'armes"
                                      IsChecked="True"
                                      Checked="OnGearShowNames_Changed" Unchecked="OnGearShowNames_Changed"
                                      ToolTip="Affiche le nom de l'arme dans la liste (résolu via w_name.bin pour les armes des personnages humains)"/>
                            <Grid DockPanel.Dock="Top" Margin="6">
                                <TextBox x:Name="GearFilterBox" Padding="4,3"
                                         TextChanged="OnGearFilter_Changed"
                                         ToolTip="Filtrer par identifiant ou aptitude"/>
                                <TextBlock Text="🔍 Filtrer..." Foreground="#888888"
                                           Margin="8,0,0,0" VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           x:Name="GearFilterPlaceholder"/>
                            </Grid>
                            <TextBlock DockPanel.Dock="Bottom" x:Name="GearCountText"
                                       Margin="6,4" Foreground="#666666" FontSize="11"/>
                            <ListBox x:Name="GearListBox"
                                     BorderThickness="0"
                                     SelectionChanged="OnGearSelection_Changed"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                        </DockPanel>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid Margin="20">
                            <TextBlock x:Name="NoGearSelectedMessage"
                                       Text="← Sélectionne un équipement dans la liste pour voir ses propriétés."
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       TextAlignment="Center" TextWrapping="Wrap" MaxWidth="600"
                                       Foreground="Gray" FontStyle="Italic"/>

                            <StackPanel x:Name="GearDetailsPanel" Visibility="Collapsed">
                                <TextBlock x:Name="GearHeaderText" FontSize="20" FontWeight="Bold"/>
                                <TextBlock x:Name="GearInfoText" Foreground="#666666" Margin="0,0,0,15"/>

                                <GroupBox x:Name="GearNameGroup" Header="Nom (langue sélectionnée)">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <Label   Grid.Row="0" Grid.Column="0" Content="Nom complet :"/>
                                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="GearNameBox"
                                                 TextChanged="OnGearMechanic_Changed"
                                                 PreviewKeyDown="OnMonsterTextBox_KeyDown"/>
                                        <Label   Grid.Row="1" Grid.Column="0" Content="Nom (court) :"/>
                                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="GearSimpleNameBox"
                                                 TextChanged="OnGearMechanic_Changed"
                                                 PreviewKeyDown="OnMonsterTextBox_KeyDown"/>
                                        <Label   Grid.Row="2" Grid.Column="0" Content="Modèle w_name :"/>
                                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="GearWeaponNameModelBox"
                                                 TextChanged="OnGearMechanic_Changed"
                                                 ToolTip="ID modèle stocké dans w_name.bin pour ce nom et ce personnage."/>
                                    </Grid>
                                </GroupBox>

                                <GroupBox Header="Propriétés">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="120"/><ColumnDefinition Width="20"/><ColumnDefinition Width="120"/><ColumnDefinition Width="120"/><ColumnDefinition Width="20"/><ColumnDefinition Width="120"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                        <Label   Grid.Row="0" Grid.Column="0" Content="Possesseur :"/>
                                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="GearOwnerBox" IsReadOnly="True"/>
                                        <Label   Grid.Row="0" Grid.Column="3" Content="Type :"/>
                                        <TextBox Grid.Row="0" Grid.Column="4" x:Name="GearTypeBox" IsReadOnly="True"/>
                                        <Label   Grid.Row="0" Grid.Column="6" Content="Slots :"/>
                                        <TextBox Grid.Row="0" Grid.Column="7" x:Name="GearSlotsBox" TextChanged="OnGearMechanic_Changed"/>

                                        <Label   Grid.Row="1" Grid.Column="0" Content="Formule (ID) :"/>
                                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="GearFormulaBox" TextChanged="OnGearMechanic_Changed"/>
                                        <Label   Grid.Row="1" Grid.Column="3" Content="Puissance :"/>
                                        <TextBox Grid.Row="1" Grid.Column="4" x:Name="GearPowerBox" TextChanged="OnGearMechanic_Changed"/>
                                        <Label   Grid.Row="1" Grid.Column="6" Content="Critique % :"/>
                                        <TextBox Grid.Row="1" Grid.Column="7" x:Name="GearCritBox" TextChanged="OnGearMechanic_Changed"/>

                                        <Label   Grid.Row="2" Grid.Column="0" Content="Modèle (ID) :"/>
                                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="GearModelBox" TextChanged="OnGearMechanic_Changed"/>
                                        <Label   Grid.Row="2" Grid.Column="3" Content="Armure (byte) :"/>
                                        <TextBox Grid.Row="2" Grid.Column="4" x:Name="GearArmorByteBox" TextChanged="OnGearMechanic_Changed"/>
                                        <Label   Grid.Row="2" Grid.Column="6" Content="Flags bruts :"/>
                                        <TextBox Grid.Row="2" Grid.Column="7" x:Name="GearFlagsBox" TextChanged="OnGearMechanic_Changed"/>

                                        <Label   Grid.Row="3" Grid.Column="0" Content="Index nom 1 :"/>
                                        <TextBox Grid.Row="3" Grid.Column="1" x:Name="GearNameId1Box" TextChanged="OnGearMechanic_Changed"
                                                 ToolTip="shop_arms.bin : index de nom dans w_name.bin. Non présent dans buki_get.bin."/>
                                        <Label   Grid.Row="3" Grid.Column="3" Content="Index nom 2 :"/>
                                        <TextBox Grid.Row="3" Grid.Column="4" x:Name="GearNameId2Box" TextChanged="OnGearMechanic_Changed"
                                                 ToolTip="Second octet de nom du format normal, conservé par le jeu."/>
                                    </Grid>
                                </GroupBox>

                                <GroupBox Header="Drapeaux">
                                    <WrapPanel x:Name="GearFlagsPanel"/>
                                </GroupBox>

                                <GroupBox Header="Aptitudes (4 slots — a_ability.bin)">
                                    <ItemsControl x:Name="GearAbilitiesItemsControl">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="36"/>
                                                        <ColumnDefinition Width="320"/>
                                                        <ColumnDefinition Width="120"/>
                                                        <ColumnDefinition Width="90"/>
                                                        <ColumnDefinition Width="90"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Slot}" VerticalAlignment="Center"/>
                                                    <ComboBox Grid.Column="1"
                                                              ItemsSource="{Binding Options}"
                                                              DisplayMemberPath="DisplayName"
                                                              SelectedValuePath="Id"
                                                              SelectedValue="{Binding SelectedId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              SelectionChanged="OnGearMechanic_Changed"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding CategoryLabel}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding HexId}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                    <TextBlock Grid.Column="4" Text="{Binding Status}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </GroupBox>

                                <Border Margin="0,8,0,0" Padding="6" Background="#F5F5F5" CornerRadius="3">
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="ApplyGearButton" Content="✓ Appliquer l'équipement"
                                                Click="OnApplyGear_Click" IsEnabled="False"
                                                Padding="10,4" Margin="0,0,8,0"
                                                ToolTip="Marque weapon.bin/buki_get.bin/shop_arms.bin et éventuellement w_name.bin pour la sauvegarde."/>
                                        <Button x:Name="ApplyWeaponNameAllLanguagesButton" Content="⇄ Noms toutes langues"
                                                Click="OnApplyWeaponNameAllLanguages_Click" IsEnabled="False"
                                                Padding="10,4" Margin="0,0,8,0"
                                                ToolTip="Applique le nom complet/court et le modèle w_name de cette arme dans tous les w_name.bin chargés."/>
                                        <Button x:Name="RevertGearButton" Content="↶ Annuler"
                                                Click="OnRevertGear_Click" IsEnabled="False"
                                                Padding="10,4" Margin="0,0,8,0"
                                                ToolTip="Restaure l'équipement depuis l'état en mémoire."/>
                                        <TextBlock x:Name="GearEditStatusText" VerticalAlignment="Center"
                                                   Foreground="#666666" FontStyle="Italic"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

            <!-- ============ ONGLET APTITUDES D'ÉQUIPEMENT (a_ability.bin) ============ -->
            <TabItem x:Name="TabAbilities" Header="Aptitudes équipements" IsEnabled="False">
                <DockPanel>
                    <Border DockPanel.Dock="Left" BorderBrush="#CCCCCC" BorderThickness="0,0,1,0" Width="320">
                        <DockPanel>
                            <ComboBox DockPanel.Dock="Top" x:Name="AbilityCategoryFilter"
                                      Margin="6,6,6,0"
                                      SelectionChanged="OnAbilityCategoryFilter_Changed"
                                      ToolTip="Filtrer par catégorie d'équipement (basé sur kaizou.bin)">
                                <ComboBoxItem Content="Toutes les aptitudes" IsSelected="True" Tag="all"/>
                                <ComboBoxItem Content="⚔ Aptitudes Armes uniquement" Tag="weapon"/>
                                <ComboBoxItem Content="🛡 Aptitudes Armures uniquement" Tag="armor"/>
                                <ComboBoxItem Content="Aptitudes Armes ET Armures" Tag="both"/>
                                <ComboBoxItem Content="Sans recette de craft" Tag="none"/>
                            </ComboBox>
                            <Grid DockPanel.Dock="Top" Margin="6">
                                <TextBox x:Name="AbilityFilterBox" Padding="4,3"
                                         TextChanged="OnAbilityFilter_Changed"
                                         ToolTip="Filtrer par nom"/>
                                <TextBlock Text="🔍 Filtrer..." Foreground="#888888"
                                           Margin="8,0,0,0" VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           x:Name="AbilityFilterPlaceholder"/>
                            </Grid>
                            <TextBlock DockPanel.Dock="Bottom" x:Name="AbilityCountText"
                                       Margin="6,4" Foreground="#666666" FontSize="11"/>
                            <ListBox x:Name="AbilityListBox"
                                     BorderThickness="0"
                                     SelectionChanged="OnAbilitySelection_Changed"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                        </DockPanel>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid Margin="20">
                            <TextBlock x:Name="NoAbilitySelectedMessage"
                                       Text="← Sélectionne une aptitude dans la liste pour voir ses propriétés."
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="Gray" FontStyle="Italic"/>

                            <StackPanel x:Name="AbilityDetailsPanel" Visibility="Collapsed">
                                <TextBlock x:Name="AbilityHeaderText" FontSize="20" FontWeight="Bold"/>
                                <TextBlock x:Name="AbilityInfoText" Foreground="#666666" Margin="0,0,0,15"/>

                                <GroupBox x:Name="AbilityTextsGroup" Header="Texte">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <Label   Grid.Row="0" Grid.Column="0" Content="Nom :"/>
                                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="AbilityNameBox" TextChanged="OnAbilityEdit_TextChanged"/>
                                        <Label   Grid.Row="1" Grid.Column="0" Content="Nom (court) :"/>
                                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="AbilitySimpleNameBox" TextChanged="OnAbilityEdit_TextChanged"/>
                                        <Label   Grid.Row="2" Grid.Column="0" Content="Description :" VerticalAlignment="Top" Margin="0,4,0,0"/>
                                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="AbilityDescBox" TextChanged="OnAbilityEdit_TextChanged" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="50" MaxHeight="120" VerticalScrollBarVisibility="Auto"/>
                                        <Label   Grid.Row="3" Grid.Column="0" Content="Desc. (court) :" VerticalAlignment="Top" Margin="0,4,0,0"/>
                                        <TextBox Grid.Row="3" Grid.Column="1" x:Name="AbilitySimpleDescBox" TextChanged="OnAbilityEdit_TextChanged" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="30" MaxHeight="80" VerticalScrollBarVisibility="Auto"/>
                                    </Grid>
                                </GroupBox>

                                <GroupBox Header="Métadonnées">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="100"/><ColumnDefinition Width="20"/><ColumnDefinition Width="120"/><ColumnDefinition Width="100"/><ColumnDefinition Width="20"/><ColumnDefinition Width="120"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                        <Label   Grid.Row="0" Grid.Column="0" Content="Icône :"/>
                                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="AbilityIconBox" TextChanged="OnAbilityEdit_TextChanged"/>
                                        <Label   Grid.Row="0" Grid.Column="3" Content="Groupe :"/>
                                        <TextBox Grid.Row="0" Grid.Column="4" x:Name="AbilityGroupBox" TextChanged="OnAbilityEdit_TextChanged"/>
                                        <Label   Grid.Row="0" Grid.Column="6" Content="Niveau :"/>
                                        <TextBox Grid.Row="0" Grid.Column="7" x:Name="AbilityGroupLevelBox" TextChanged="OnAbilityEdit_TextChanged"/>
                                        <Label   Grid.Row="1" Grid.Column="0" Content="Bonus stat :"/>
                                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="AbilityStatAmountBox" TextChanged="OnAbilityEdit_TextChanged"/>
                                        <Label   Grid.Row="1" Grid.Column="3" Content="Cible bonus :"/>
                                        <TextBox Grid.Row="1" Grid.Column="4" x:Name="AbilityStatFlagsBox" TextChanged="OnAbilityEdit_TextChanged"/>
                                        <Label   Grid.Row="1" Grid.Column="6" Content="Spécial (Intl.) :"/>
                                        <TextBox Grid.Row="1" Grid.Column="7" x:Name="AbilityIntlBonusBox" TextChanged="OnAbilityEdit_TextChanged"/>
                                    </Grid>
                                </GroupBox>

                                <GroupBox Header="Recettes de customisation (kaizou.bin)">
                                    <StackPanel>
                                        <TextBlock x:Name="AbilityRecipeStatusText"
                                                   Margin="0,0,0,8" Foreground="#666666" FontStyle="Italic"/>

                                        <!-- Recette ARME -->
                                        <Grid x:Name="AbilityWeaponRecipeGrid" Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="140"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="120"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="⚔ Sur une arme :"
                                                       FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <ComboBox Grid.Column="1" x:Name="AbilityWeaponRecipeItemCombo"
                                                      Margin="0,0,4,0"
                                                      DisplayMemberPath="DisplayName"
                                                      SelectedValuePath="Id"
                                                      SelectionChanged="OnAbilityRecipeItem_Changed"
                                                      ToolTip="Objet requis (résolu depuis item.bin)"/>
                                            <TextBox Grid.Column="2" x:Name="AbilityWeaponRecipeQtyBox"
                                                     TextChanged="OnAbilityEdit_TextChanged"
                                                     ToolTip="Quantité d'objets nécessaire" TextAlignment="Center"/>
                                            <TextBox Grid.Column="3" x:Name="AbilityWeaponRecipeItemIdBox"
                                                     IsReadOnly="True" Background="#FAFAFA" Margin="4,0,0,0"
                                                     FontFamily="Consolas" FontSize="11"
                                                     ToolTip="ID hex de l'objet (référence item.bin)"
                                                     TextAlignment="Center"/>
                                        </Grid>

                                        <!-- Recette ARMURE -->
                                        <Grid x:Name="AbilityArmorRecipeGrid">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="140"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="120"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="🛡 Sur une armure :"
                                                       FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <ComboBox Grid.Column="1" x:Name="AbilityArmorRecipeItemCombo"
                                                      Margin="0,0,4,0"
                                                      DisplayMemberPath="DisplayName"
                                                      SelectedValuePath="Id"
